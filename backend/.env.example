NODE_ENV=development
PORT=5001

# MongoDB (Required in production)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/aiva_enterprises

# Authentication (Required)
JWT_SECRET=your_super_secret_jwt_string_here

# Cloudinary - Image Uploads (Required)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Optional)
EMAIL_USER=Enquiry@aivaenterprises.com
EMAIL_PASS=your_email_app_password

# Client URL (Optional, defaults to live site)
CLIENT_URL=http://localhost:5173

# Gemini AI (Optional)
GEMINI_API_KEY=your_gemini_api_key
